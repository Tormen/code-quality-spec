#!/usr/bin/env python3
"""Render the harness adapters from SPEC.md -- the spec is the one owner.

usage: render-adapters [-h] [-V] [--check] [--spec FILE] [--out DIR]
                       [--sections LIST] [--version] [--run-tests [FILTER]]

Reads SPEC.md, splits it into its numbered sections, and writes the files
each adapter needs from those sections. A hand edit to a rendered file is
overwritten by the next render; `--check` renders to memory and exits 1
when any file on disk differs, so a pre-commit hook can refuse drift.

Standard library only; Python 3.9 or later; no shell. Runs the same on
macOS, Linux and Windows.
"""
from __future__ import annotations

import argparse
import contextlib
import hashlib
import io
import os
import re
import sys
import tempfile
import traceback
from collections.abc import Callable, Iterable
from dataclasses import dataclass
from pathlib import Path

VERSION = "0.1"
EXIT_SOFTWARE = 70
EXIT_INTERRUPT = 130
HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
DEFAULT_SPEC = ROOT / "SPEC.md"
DEFAULT_SCENARIOS = ROOT / "proof" / "scenarios.md"
DEFAULT_OUT = ROOT / "adapters"

# Step 0 of every proof: how THIS harness shows what it loaded. The
# scenarios themselves are harness-neutral and live in proof/scenarios.md.
PROOF_STEP0 = {
    "claude-code": (
        "Claude Code loads `~/.claude/CLAUDE.md` and the project's `CLAUDE.md` "
        "into every session, and a PreToolUse hook's own output appears in the "
        "transcript. Step 0: ask the agent to quote the first line of the CODE "
        "DESIGN section; if it cannot, the memory is not loaded. Then run the "
        "gates once on purpose (write a file with `head -5`): the refusal must "
        "appear."
    ),
    "vscode-copilot": (
        "Copilot shows the instruction files it applied in the response's "
        "references list (expand it under the answer). Step 0: ask any "
        "question in Copilot Chat and confirm `.github/copilot-instructions.md` "
        "is listed; open a `.py` file and confirm `python.instructions.md` "
        "joins it; in agent mode confirm `AGENTS.md`. Absent means not "
        "applied: wrong path, a glob that does not match, or the setting "
        "`github.copilot.chat.codeGeneration.useInstructionFiles` is off. "
        "Nothing below counts until step 0 passes."
    ),
}

# Claude Code: the checks that need judgement, by moment. Sections 2.4 and
# 2.6 are left out by default because a CLAUDE.md usually already states
# its tool and agent conventions; pass --sections to change that.
CLAUDE_SECTIONS = ("1", "2.1", "2.2", "2.3", "2.5")


class Err(Exception):
    """A failure with its code: ERROR <code> [<exit>]: <text>."""

    def __init__(self, code: str, text: str, exit_code: int = 1) -> None:
        super().__init__(text)
        self.code = code
        self.text = text
        self.exit_code = exit_code


def err(code: str, text: str, exit_code: int = 1) -> Err:
    """Build the error to raise; the code is unique to its raising line."""
    return Err(code, text, exit_code)


@dataclass(frozen=True)
class Section:
    """One numbered section of the spec: its id ("2.1"), title and body."""

    ident: str
    title: str
    body: str


_HEADING = re.compile(r"^(#{2,3}) (\d+(?:\.\d+)?)\.? (.+?)\s*$")


def parse_spec(text: str) -> dict[str, Section]:
    """Split the spec at its numbered ## and ### headings.

    A ## section's body ends where its first ### starts, so "2" holds the
    introduction of section 2 and "2.1" its first subsection. Unnumbered
    headings ("## Site parameters") close the previous section and are not
    sections of their own.
    """
    sections: dict[str, Section] = {}
    ident = ""
    title = ""
    lines: list[str] = []

    def close() -> None:
        if ident:
            sections[ident] = Section(ident, title, "\n".join(lines).strip("\n") + "\n")

    for line in text.splitlines():
        m = _HEADING.match(line)
        if m:
            close()
            ident, title, lines = m.group(2), m.group(3), []
            continue
        if line.startswith("## ") or line.startswith("### "):
            close()
            ident, title, lines = "", "", []
            continue
        if line.strip() == "---":
            continue
        lines.append(line)
    close()
    if not sections:
        raise err("00001", "no numbered sections found in the spec")
    return sections


def pick(sections: dict[str, Section], wanted: Iterable[str]) -> list[Section]:
    """The requested sections, in the order requested; a missing id is an error."""
    out: list[Section] = []
    for ident in wanted:
        if ident not in sections:
            raise err("00002", f"section {ident!r} is not in the spec")
        out.append(sections[ident])
    return out


_CROSSREF = re.compile(r'\(see "([^"]+)" in (\d+\.\d+)\)')


def detach_crossrefs(body: str, present: Iterable[str]) -> str:
    """Point a cross-reference at the spec when its target is not rendered."""
    kept = set(present)

    def repl(m: re.Match[str]) -> str:
        if m.group(2) in kept:
            return m.group(0)
        return f'(see the spec, {m.group(2)} "{m.group(1)}")'

    return _CROSSREF.sub(repl, body)


def spec_stamp(spec_text: str) -> str:
    """A short hash of the spec, so a rendered file names what it came from."""
    return hashlib.sha256(spec_text.encode("utf-8")).hexdigest()[:12]


def render_claude_memory(spec_text: str, wanted: Iterable[str]) -> str:
    """The section a Claude Code CLAUDE.md gets: the chosen spec sections."""
    sections = parse_spec(spec_text)
    chosen = pick(sections, wanted)
    idents = [s.ident for s in chosen]
    out = io.StringIO()
    out.write("## CODE DESIGN: the checks, by the moment they fire\n\n")
    out.write(_stamp_line(spec_text))
    for s in chosen:
        out.write(f"### {s.title}\n\n")
        out.write(detach_crossrefs(s.body, idents))
        out.write("\n")
    return out.getvalue().rstrip("\n") + "\n"


_ROW = re.compile(r"^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*$")


def table_row(body: str, first_cell: str) -> str:
    """The "how" cell of the enforcement-table row whose first cell matches."""
    for line in body.splitlines():
        m = _ROW.match(line)
        if m and m.group(1) == first_cell:
            return m.group(3)
    raise err("00005", f"no table row starts with {first_cell!r}")


def _stamp_line(spec_text: str) -> str:
    return (
        f"<!-- rendered by tools/render-adapters from SPEC.md {spec_stamp(spec_text)}; "
        "do not edit here -- edit the spec and re-render -->\n\n"
    )


def _sections_text(sections: dict[str, Section], idents: list[str], heading: str) -> str:
    out = io.StringIO()
    for s in pick(sections, idents):
        out.write(f"{heading} {s.title}\n\n")
        out.write(detach_crossrefs(s.body, idents))
        out.write("\n")
    return out.getvalue()


def _with_frontmatter(apply_to: str, text: str) -> str:
    return f'---\napplyTo: "{apply_to}"\n---\n\n{text}'


def render_copilot(spec_text: str) -> list[Rendered]:
    """VS Code Copilot: repo-wide instructions, path-scoped ones, AGENTS.md.

    Copilot sends `.github/copilot-instructions.md` with every request, so
    it carries only what applies to every edit (layer 1 and the by-moment
    checks); the tool's face and Python go into path-scoped instruction
    files; the agent-behaviour groups go to AGENTS.md, which agent mode
    reads.
    """
    s = parse_spec(spec_text)
    stamp = _stamp_line(spec_text)
    repo_wide = (
        "# Code quality: the checks, by the moment they fire\n\n" + stamp
        + _sections_text(s, ["1", "2.1", "2.2", "2.3"], "##")
        + "\n## Scope\n\nPath-scoped instructions in `.github/instructions/` add the "
        "tool-level and Python checks; `AGENTS.md` holds how the agent itself works. "
        "Checks a tool can decide are enforced by the repository's pre-commit "
        "configuration, not by this file.\n"
    )
    python = _with_frontmatter(
        "**/*.py",
        "# Python\n\n" + stamp + _sections_text(s, ["2.5"], "##")
        + "\n## Mechanical checks (the linter and the type checker decide these)\n\n"
        + table_row(s["3"].body, "Python mechanics") + "\n",
    )
    tool_face = _with_frontmatter(
        "**/*.py,**/*.sh",
        "# A command-line tool's face\n\n" + stamp + _sections_text(s, ["2.4"], "##"),
    )
    shell = _with_frontmatter(
        "**/*.sh",
        "# Shell\n\n" + stamp + "## Mechanical checks\n\n"
        + table_row(s["3"].body, "shell mechanics") + "\n\n"
        + "The `secret` and `crash-safe` checks of the repo-wide instructions apply "
        "with particular force in shell: no secret literal in a command, every "
        "write via a temporary file and rename.\n",
    )
    agents = (
        "# How the agent works here\n\n" + stamp
        + _sections_text(s, ["1", "2.6"], "##")
    )
    # The user-profile set: the same texts, for EVERY workspace of a VS Code
    # user rather than one repository. There is no profile-level
    # copilot-instructions.md or AGENTS.md, so those two become instruction
    # files that apply to every path.
    everywhere = _with_frontmatter("**", repo_wide)
    agent_everywhere = _with_frontmatter("**", agents)
    return [
        Rendered("vscode-copilot/.github/copilot-instructions.md", repo_wide),
        Rendered("vscode-copilot/.github/instructions/python.instructions.md", python),
        Rendered("vscode-copilot/.github/instructions/tool-face.instructions.md", tool_face),
        Rendered("vscode-copilot/.github/instructions/shell.instructions.md", shell),
        Rendered("vscode-copilot/AGENTS.md", agents),
        Rendered("vscode-copilot/user-profile/code-quality.instructions.md", everywhere),
        Rendered("vscode-copilot/user-profile/agent.instructions.md", agent_everywhere),
        Rendered("vscode-copilot/user-profile/python.instructions.md", python),
        Rendered("vscode-copilot/user-profile/tool-face.instructions.md", tool_face),
        Rendered("vscode-copilot/user-profile/shell.instructions.md", shell),
    ]


def render_proof(harness: str, scenarios: str) -> str:
    """The harness's PROOF.md: its step 0, then the neutral scenarios."""
    if harness not in PROOF_STEP0:
        raise err("00006", f"no step 0 known for harness {harness!r}")
    return (
        f"# Proof -- {harness}\n\n"
        "<!-- rendered by tools/render-adapters from proof/scenarios.md; do not edit "
        "here -- edit the scenarios and re-render. Append runs under 'Runs'. -->\n\n"
        "## Step 0 -- loaded?\n\n" + PROOF_STEP0[harness] + "\n\n"
        + scenarios.split("\n", 1)[1].lstrip("\n")
        + "\n## Runs\n\n(harness, version, date, scenarios passed / failed)\n"
    )


@dataclass(frozen=True)
class Rendered:
    """One output file: its path relative to the adapters directory and text."""

    rel: str
    text: str


def render_all(spec_text: str, sections: Iterable[str], scenarios: str) -> list[Rendered]:
    """Every rendered file, for every adapter this script knows."""
    return [
        Rendered("claude-code/CLAUDE.section.md", render_claude_memory(spec_text, sections)),
        Rendered("claude-code/PROOF.md", render_proof("claude-code", scenarios)),
        *render_copilot(spec_text),
        Rendered("vscode-copilot/PROOF.md", render_proof("vscode-copilot", scenarios)),
    ]


def write_atomic(path: Path, text: str) -> None:
    """Write via a temp file in the same directory, then rename."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def build_id() -> str:
    """A hash of the running file: identifies the exact bytes."""
    data = Path(__file__).resolve().read_bytes()
    return hashlib.sha256(data).hexdigest()[:12]


def run(args: argparse.Namespace) -> int:
    spec_path = Path(args.spec)
    out_dir = Path(args.out)
    try:
        spec_text = spec_path.read_text(encoding="utf-8")
    except OSError as e:
        raise err("00003", f"cannot read the spec: {spec_path} ({e.strerror})") from e
    wanted = tuple(s.strip() for s in args.sections.split(",") if s.strip())
    try:
        scenarios = Path(args.scenarios).read_text(encoding="utf-8")
    except OSError as e:
        raise err("00007", f"cannot read the scenarios: {args.scenarios} ({e.strerror})") from e
    rendered = render_all(spec_text, wanted, scenarios)
    differ: list[str] = []
    for r in rendered:
        target = out_dir / r.rel
        on_disk = target.read_text(encoding="utf-8") if target.exists() else None
        if on_disk == r.text:
            if args.verbose:
                print(f"    > {r.rel}  unchanged")
            continue
        differ.append(r.rel)
        if args.check:
            print(f" >>> {r.rel}  DIFFERS from the spec ({'missing' if on_disk is None else 'stale'})")
        else:
            write_atomic(target, r.text)
            print(f" >>> {r.rel}  {'created' if on_disk is None else 'rewritten'} (from SPEC.md {spec_stamp(spec_text)})")
    if args.check:
        if differ:
            print(f"--> {len(differ)} rendered file(s) out of date: run render-adapters")
            return 1
        print(f"in sync ({len(rendered)}/{len(rendered)} rendered files match the spec)")
    elif not differ:
        print(f"nothing to do ({len(rendered)}/{len(rendered)} rendered files already match the spec)")
    return 0


